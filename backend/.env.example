APP_NAME="UltraBlue+ Industrial Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ultrablueplus
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# ----------------------------------------------------
# JWT Authentication & Session Secret
# ----------------------------------------------------
JWT_SECRET=ultrablue_jwt_master_secret_key_2026_odisha_enterprise_secure
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ultrablueplus.com"
MAIL_FROM_NAME="${APP_NAME}"

# Plant & Factory Configuration
FACTORY_PLANT_LOCATION="Bhadrak Industrial Estate, Odisha, India"
DISPATCH_HOTLINE="+91 9853675971"
ISO_STANDARD="ISO 22241-1 / BIS Certified"
